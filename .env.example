# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---------- AI models (all via OpenRouter) ----------
# Omni model: hears the user's audio, reads screenshots, writes the reply.
LLM_MODEL=qwen/qwen3.8-omni-flash
# Reasoning makes Qwen3.8 Omni ~10x slower (19 s vs 2 s): keep false for live calls.
LLM_REASONING=false
# Voice of the reply. Leave TTS_MODEL empty to let the browser speak instead.
TTS_MODEL=elevenlabs/eleven-flash-v2.5
# ElevenLabs voice id ("Rachel", English). Any ElevenLabs voice id works.
TTS_VOICE=21m00Tcm4TlvDq8ikWAM
TTS_FORMAT=mp3
AI_TIMEOUT_S=60

# ---------- Services ----------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Leave empty: the browser uses <page host>:8000. Set e.g. https://api.example.com when behind a proxy.
NEXT_PUBLIC_BACKEND_URL=
GREETING_ENABLED=true
LOG_LEVEL=INFO
FRONTEND_PORT=3000
BACKEND_PORT=8000
